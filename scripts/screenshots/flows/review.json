      "采购合同",
      "销售合同",
      "服务合同",
      "其他"
     ],
     "instruction": ""
    }
   },
   {
    "id": "clauses",
    "kind": "kb",
    "title": "检索条款库",
    "position": {
     "x": 900.0,
     "y": 20.0
    },
    "config": {
     "knowledge_base_ids": [],
     "query": "{{kind.category}} 审查要点 {{facts.contract_type}}",
     "mode": "hybrid",
     "top_k": 8,
     "rerank_top_n": 3,
     "score_threshold": 0.35,
     "max_context_chars": 8000
    }
   },
   {
    "id": "unsupported",
    "kind": "answer",
    "title": "暂不支持",
    "position": {
     "x": 600.0,
     "y": 340.0
    },
    "config": {
     "template": "这类合同暂不支持自动审校，请发起人工审核。"
    }
   },
   {
    "id": "review",
    "kind": "llm",
    "title": "逐条比对与风险分级",
    "position": {
     "x": 1200.0,
     "y": 20.0
    },
    "config": {
     "model_id": null,
     "system_prompt": "你是企业法务。",
     "prompt": "对照条款库要求，逐条审查下面的{{kind.category}}，列出风险条款，每条注明风险等级（高 / 中 / 低）、原文、问题和修改建议。\n没有高风险条款时，第一行写「无高风险条款」。\n\n合同要素：{{facts.json}}\n\n条款库：\n{{clauses.context}}\n\n合同正文：\n{{start.contract}}",
     "temperature": null,
     "max_tokens": null,
     "history": false
    }
   },
   {
    "id": "risky",
    "kind": "ifelse",
    "title": "存在高风险条款？",
    "position": {
     "x": 900.0,
     "y": 340.0
    },
    "config": {
     "conditions": [
      {
       "left": "{{review.text}}",
       "operator": "not_contains",
       "right": "无高风险条款"
      }
     ],
     "logic": "and"
    }
   },
   {
    "id": "alert",
    "kind": "answer",
    "title": "输出风险报告",
    "position": {
     "x": 1200.0,
     "y": 300.0
    },
    "config": {
     "template": "**发现高风险条款，建议提交法务复核。**\n\n{{review.text}}"
    }
   },
   {
    "id": "clean",
    "kind": "answer",
    "title": "输出审校结论",
    "position": {
     "x": 1200.0,
     "y": 470.0
    },
    "config": {
     "template": "未发现高风险条款。\n\n{{review.text}}"
    }
   }
